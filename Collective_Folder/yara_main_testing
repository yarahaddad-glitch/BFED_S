# ------------------------------------------
# FUNCTION: CREATE TARGET POSE
# ------------------------------------------

def create_target(position):

    target_matrix = np.eye(4)

    target_matrix[:3, :3] = orientation
    target_matrix[:3, 3] = position

    return SE3(target_matrix)


# ------------------------------------------
# FUNCTION: MOVE YARABOT
# ------------------------------------------

def move_yarabot(target_position, steps=80):

    global attached, grasp_transform

    q_start = np.array(yarabot.q, dtype=float).copy()

    target_pose = create_target(target_position)

    solution = yarabot.ikine_LM(
        target_pose,
        q0=q_start
    )

    if not solution.success:
        print("IK failed:", target_position)
        return False

    # Generate smooth joint movement
    q_matrix = jtraj(
        q_start,
        solution.q,
        steps
    ).q

    for q in q_matrix:

        yarabot.q = q

        # Update nugget position while attached
        if attached:

            ee_pose = yarabot.fkine(yarabot.q)

            nuggets_file.T = (
                ee_pose * grasp_transform
            ).A

        env.step(0.05)

    actual = yarabot.fkine(yarabot.q).t
    error = np.linalg.norm(actual - target_position)

    print("Reached:", actual)
    print("Position error:", error)

    return error < 0.01

# ==========================================
# RETURN YARABOT TO STARTING POSITION
# ==========================================

def return_yarabot_home():

    print("Returning YaraBot home")

    q_current = np.array(yarabot.q, dtype=float).copy()

    q_matrix = jtraj(
        q_current,
        q_home,
        100
    ).q

    for q in q_matrix:
        yarabot.q = q
        env.step(0.05)

    print("YaraBot returned home!")

